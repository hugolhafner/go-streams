          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum(stream_partitioned_paused_depth{job=~\"$job\"})",
          "legendFormat": "paused",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
