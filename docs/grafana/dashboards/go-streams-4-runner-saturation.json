    {
      "id": 7,
      "type": "timeseries",
      "title": "Worker queue depth vs paused depth",
      "description": "stream.partitioned.queue.depth = records buffered in worker channels; stream.partitioned.paused.depth = records held for partitions paused at the consumer. Paused > 0 means backpressure has kicked in. Docs suggest alerting on queue depth > 1000.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(stream_partitioned_queue_depth{job=~\"$job\"})",
