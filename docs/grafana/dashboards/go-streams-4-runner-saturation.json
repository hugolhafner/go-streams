{
  "uid": "go-streams-runner",
  "title": "[go-streams] Runner & Saturation",
  "description": "Deep dive into go-streams runner saturation: per-partition consumer lag, PartitionedRunner backpressure (queue/paused depth), poll-loop health, produce path and rebalance stability.",
  "tags": [
    "go-streams",
    "kafka",
    "golden-signals",
    "owner:go-streams"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "job",
        "label": "Application (job)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(messaging_consumer_messages_total, job)",
        "query": {
          "query": "label_values(messaging_consumer_messages_total, job)",
          "refId": "var-job"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "regex": "",
        "hide": 0,
        "allValue": ".+"
      },
      {
        "name": "topic",
        "label": "Topic",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(stream_consumer_lag_count{job=~\"$job\"}, messaging_destination_name)",
        "query": {
          "query": "label_values(stream_consumer_lag_count{job=~\"$job\"}, messaging_destination_name)",
          "refId": "var-topic"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "regex": "",
        "hide": 0,
        "allValue": ".+"
      },
      {
        "name": "partition",
        "label": "Partition",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(stream_consumer_lag_count{job=~\"$job\", messaging_destination_name=~\"$topic\"}, messaging_destination_partition_id)",
        "query": {
          "query": "label_values(stream_consumer_lag_count{job=~\"$job\", messaging_destination_name=~\"$topic\"}, messaging_destination_partition_id)",
          "refId": "var-partition"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "regex": "",
        "hide": 0,
        "allValue": ".+"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
