      "targets": [
        {
          "expr": "sum by (le) (rate(stream_process_duration_seconds_bucket{job=~\"$job\", messaging_destination_name=~\"$topic\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "steps": 64,
          "reverse": false,
          "exponent": 0.5,
          "fill": "dark-orange"
