    {
      "id": 14,
      "type": "timeseries",
      "title": "Retry rate by phase",
      "description": "rate(stream.process.retries) split by error phase. Docs suggest alerting above 5 retries/s. A retry storm re-traverses the topology per attempt, inflating node/edge metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "expr": "sum by (stream_error_phase) (rate(stream_process_retries_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{stream_error_phase}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
