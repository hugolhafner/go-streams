    {
      "id": 7,
      "type": "heatmap",
      "title": "Processing latency distribution",
      "description": "Heatmap of stream.process.duration. Bi-modal bands usually mean one code path (e.g. an external call) is much slower than the rest \u2014 use Topology Explorer to find the node.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
